[Unit]
Description=Math on the Edge: Cangur Tutor web page and API (port 8090)
After=local-fs.target math-llm.service

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/datathon-UPC-maths-qualcomm-arduino-unoq
ExecStart=/usr/bin/python3 /home/arduino/datathon-UPC-maths-qualcomm-arduino-unoq/tutor_server.py --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
